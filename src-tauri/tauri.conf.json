{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zumic",
  "version": "0.3.2",
  "identifier": "com.zumic.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "https://music.youtube.com",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
