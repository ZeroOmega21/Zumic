{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability default for Zumic",
  "local": true,
  "remote": {
    "urls": [
      "https://music.youtube.com",
      "https://music.youtube.com/*",
      "https://*.youtube.com",
      "https://*.youtube.com/*"
    ]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "allow-update-presence",
    "allow-clear-presence",
    "allow-get-settings",
    "allow-set-minimize-to-tray"
  ]
}
